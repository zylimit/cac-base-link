{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.local)",
      "Read(**/.env.local)",
      "Read(.env.development)",
      "Read(**/.env.development)",
      "Read(.env.production)",
      "Read(**/.env.production)",
      "Read(.env.staging)",
      "Read(**/.env.staging)",
      "Read(.env.test)",
      "Read(**/.env.test)",
      "Read(secrets/**)",
      "Read(**/secrets/**)",
      "Read(id_rsa*)",
      "Read(**/id_rsa*)",
      "Read(id_ed25519*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(**/credentials.json)",
      "Read(**/.credentials.json)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh release *)",
      "Bash(npm publish*)",
      "Bash(docker push*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/cc-bridge.mjs session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/cc-bridge.mjs user-prompt-submit",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/cc-bridge.mjs pre-bash",
            "timeout": 35
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/cc-bridge.mjs pre-skill",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/cc-bridge.mjs pre-write",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/cc-bridge.mjs pre-agent",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/cc-bridge.mjs post-bash",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/cc-bridge.mjs post-write",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/cc-bridge.mjs pre-compact",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/cc-bridge.mjs post-compact",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/cc-bridge.mjs stop",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "implementer|code-reviewer|tester|deployer",
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/cc-bridge.mjs subagent-stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
